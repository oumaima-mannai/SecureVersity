# ============================================================
# SecureVersity Backend — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your own values.
# .env is NEVER committed to version control.
#
# Usage: cp .env.example .env   (Linux/Mac)
#        copy .env.example .env  (Windows)
# ============================================================

# --- Database ---
# PostgreSQL connection string
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/secureversity?schema=public"

# --- JWT ---
# A strong random secret key for signing JWT access tokens
JWT_SECRET="change-this-to-a-random-secret-key"

# --- Admin Bootstrap ---
# These credentials are used ONCE at first startup to auto-create
# the ADMIN_SYSTEM account in the database.
# After the first run, changing these values has no effect.
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_DEFAULT_PASSWORD="ChangeMe123!"
