
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN_SYSTEM
  RSSI
  AUDITOR
  DIRECTION
  EMPLOYEE_IT
  EMPLOYEE_HR
  EMPLOYEE_ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
}
