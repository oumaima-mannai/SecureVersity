generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  role               Role
  createdAt          DateTime            @default(now())
  fullName           String?
  isActive           Boolean             @default(true)
  mustChangePassword Boolean             @default(true)
  answers            Answer[]
  assessments        Assessment[]
  assessmentSections AssessmentSection[]
}

model Template {
  id          String            @id @default(uuid())
  name        String
  description String?
  is_default  Boolean           @default(false)
  created_at  DateTime          @default(now())
  assessments Assessment[]
  sections    SectionTemplate[]
}

model SectionTemplate {
  id                 String              @id @default(uuid())
  template_id        String
  title              String
  description        String?
  order_index        Int
  role_required      Role
  assessmentSections AssessmentSection[]
  questions          QuestionTemplate[]
  template           Template            @relation(fields: [template_id], references: [id], onDelete: Cascade)
}

model QuestionTemplate {
  id            String          @id @default(uuid())
  section_id    String
  question_text String
  type          QuestionType
  required      Boolean         @default(true)
  options       Json?
  order_index   Int
  answers       Answer[]
  section       SectionTemplate @relation(fields: [section_id], references: [id], onDelete: Cascade)
}

model Assessment {
  id          String              @id @default(uuid())
  template_id String
  name        String
  status      AssessmentStatus    @default(DRAFT)
  created_by  String
  created_at  DateTime            @default(now())
  creator     User                @relation(fields: [created_by], references: [id])
  template    Template            @relation(fields: [template_id], references: [id])
  sections    AssessmentSection[]
}

model AssessmentSection {
  id                  String          @id @default(uuid())
  assessment_id       String
  section_template_id String
  assigned_to         String?
  status              SectionStatus   @default(NOT_STARTED)
  answers             Answer[]
  assessment          Assessment      @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  assignee            User?           @relation(fields: [assigned_to], references: [id])
  sectionTemplate     SectionTemplate @relation(fields: [section_template_id], references: [id])
}

model Answer {
  id                    String            @id @default(uuid())
  assessment_section_id String
  question_template_id  String
  value                 Json
  answered_by           String?
  created_at            DateTime          @default(now())
  user                  User?             @relation(fields: [answered_by], references: [id])
  assessmentSection     AssessmentSection @relation(fields: [assessment_section_id], references: [id], onDelete: Cascade)
  questionTemplate      QuestionTemplate  @relation(fields: [question_template_id], references: [id])
}

enum Role {
  ADMIN_SYSTEM
  RSSI
  AUDITOR
  DIRECTION
  EMPLOYEE_IT
  EMPLOYEE_HR
  EMPLOYEE_ADMIN
}

enum QuestionType {
  TEXT
  YES_NO
  SELECT
  MULTI_SELECT
  TEXTAREA
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  APPROVED
}

enum SectionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  VALIDATED
}
